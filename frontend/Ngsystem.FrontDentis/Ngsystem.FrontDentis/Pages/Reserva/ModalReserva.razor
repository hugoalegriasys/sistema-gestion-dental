@inherits ModalReservaBase
<MudDialog>
    <DialogContent>
        <MudForm @ref="form">
            <MudPaper Class="pa-6">
                <MudGrid>
                    <MudItem xs="12" md="6">
                        <MudTextField Label="DNI del Paciente" Value="@objReserva.Dni" ValueChanged="@((string? v) => objReserva.Dni = v)" Required="true" RequiredError="Este campo es obligatorio" Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="8" Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Badge" />
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudSelect T="string" Label="Estado de la Reserva" Value="@objReserva.EstadoReserva" ValueChanged="@((string? v) => objReserva.EstadoReserva = v)" Required="true" RequiredError="Seleccione un estado" Variant="Variant.Outlined" Margin="Margin.Dense" AdornmentIcon="@Icons.Material.Filled.Info">
                            <MudSelectItem Value="@("Confirmada")">Confirmada</MudSelectItem>
                            <MudSelectItem Value="@("Pendiente")">Pendiente</MudSelectItem>
                            <MudSelectItem Value="@("Cancelada")">Cancelada</MudSelectItem>
                            <MudSelectItem Value="@("Reprogramada")">Reprogramada</MudSelectItem>
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudDatePicker Label="Fecha Reserva" @bind-Date="objReserva.FechaReserva" Required="true" RequiredError="Este campo es obligatorio" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudDatePicker Label="Fecha Atención" @bind-Date="objReserva.FechaAtencion" Required="true" RequiredError="Este campo es obligatorio" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudTimePicker Label="Hora Atención" @bind-Time="objReserva.HoraAtencion" Required="true" RequiredError="Este campo es obligatorio" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>

                    <MudItem xs="12">
                        <MudTextField Label="Motivo de Consulta" Value="@objReserva.MotivoConsulta" ValueChanged="@((string? v) => objReserva.MotivoConsulta = v)" Required="true" RequiredError="Este campo es obligatorio" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="2" Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.MedicalInformation" />
                    </MudItem>

                    <MudItem xs="12">
                        <MudTextField Label="Observaciones" Value="@objReserva.Observaciones" ValueChanged="@((string? v) => objReserva.Observaciones = v)" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="3" Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Notes" />
                    </MudItem>
                </MudGrid>
            </MudPaper>
        </MudForm>
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Save" OnClick="MostrarConfirmacion">Guardar</MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Default" StartIcon="@Icons.Material.Filled.Cancel" OnClick="Cancel">Cancelar</MudButton>
    </DialogActions>
</MudDialog>
