@inherits ModalAtencionCitaBase
<MudDialog>
    <DialogContent>
        <MudForm @ref="form">
            <MudPaper Class="pa-6">
                <MudText Typo="Typo.h6" GutterBottom="true">
                    <MudIcon Icon="@Icons.Material.Filled.LocalHospital" Class="mr-2" />
                    Registrar Atención Clínica
                </MudText>

                <MudGrid>
                    <MudItem xs="12">
                        <MudTextField Label="Diagnóstico"
                                      @bind-Value="Diagnostico"
                                      Required="true"
                                      RequiredError="El diagnóstico es obligatorio"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Lines="3"
                                      Adornment="Adornment.End"
                                      AdornmentIcon="@Icons.Material.Filled.MedicalServices" />
                    </MudItem>

                    <MudItem xs="12">
                        <MudTextField Label="Tratamiento Realizado"
                                      @bind-Value="TratamientoRealizado"
                                      Required="true"
                                      RequiredError="El tratamiento es obligatorio"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Lines="3"
                                      Adornment="Adornment.End"
                                      AdornmentIcon="@Icons.Material.Filled.Healing" />
                    </MudItem>

                    <MudItem xs="12">
                        <MudTextField Label="Observaciones"
                                      @bind-Value="Observaciones"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Lines="3"
                                      Adornment="Adornment.End"
                                      AdornmentIcon="@Icons.Material.Filled.Notes" />
                    </MudItem>
                </MudGrid>
            </MudPaper>
        </MudForm>
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Save" OnClick="Guardar">Guardar Atención</MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Default" StartIcon="@Icons.Material.Filled.Cancel" OnClick="Cancel">Cancelar</MudButton>
    </DialogActions>
</MudDialog>
