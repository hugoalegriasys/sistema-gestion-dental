@page "/Citas/Cita"
@using Ngsystem.FrontDentis.Components
@using Ngsystem.Infrastructure.Dtos
@inherits CitaBase

@if (estadoLoad)
{
    <Loading />
}
else
{
    <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-5">
        <MudPaper Elevation="3" Class="pa-4" Width="100%">
            <MudGrid>
                <MudItem xs="12">
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <MudText Typo="Typo.h4" GutterBottom="true" Color="Color.Primary">
                                <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Class="mr-2" />
                                Agenda de Citas
                            </MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                Total de citas: @(listaCitaDto?.Count() ?? 0)
                            </MudText>
                        </div>
                    </div>

                    <MudTable Items="@listaCitaDto"
                              Dense="false"
                              Striped="true"
                              Bordered="true"
                              Hover="true"
                              Filter="new Func<CitaResponseDto, bool>(FilterFunc1)"
                              @bind-SelectedItem="selectedItem1"
                              Loading="@_loading"
                              LoadingProgressColor="Color.Info"
                              Elevation="2">
                        <ToolBarContent>
                            <MudTextField @bind-Value="searchString1"
                                          Placeholder="Buscar por DNI, Nombre, Apellido o Estado..."
                                          Adornment="Adornment.Start"
                                          AdornmentIcon="@Icons.Material.Filled.Search"
                                          IconSize="Size.Medium"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Clearable="true">
                            </MudTextField>
                        </ToolBarContent>
                        <HeaderContent>
                            <MudTh>DNI</MudTh>
                            <MudTh>Nombre</MudTh>
                            <MudTh>Apellido</MudTh>
                            <MudTh>Fecha</MudTh>
                            <MudTh>Hora</MudTh>
                            <MudTh>Estado</MudTh>
                            <MudTh>Acciones</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>@context.DniPaciente</MudTd>
                            <MudTd>@context.NombresPaciente</MudTd>
                            <MudTd>@context.ApellidosPaciente</MudTd>
                            <MudTd>@context.FechaAtencion?.ToString("dd/MM/yyyy")</MudTd>
                            <MudTd>@(context.HoraAtencion?.ToString(@"hh\:mm") ?? "-")</MudTd>
                            <MudTd>
                                <MudMenu AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft">
                                    <ActivatorContent>
                                        <MudChip Color="@GetEstadoColor(context.EstadoCita)" Size="Size.Small">@context.EstadoCita</MudChip>
                                    </ActivatorContent>
                                    <ChildContent>
                                        <MudMenuItem OnClick="@(() => CambiarEstado(context, "Pendiente"))">Pendiente</MudMenuItem>
                                        <MudMenuItem OnClick="@(() => CambiarEstado(context, "En Atención"))">En Atención</MudMenuItem>
                                        <MudMenuItem OnClick="@(() => CambiarEstado(context, "Atendida"))">Atendida</MudMenuItem>
                                        <MudMenuItem OnClick="@(() => CambiarEstado(context, "No Asistió"))">No Asistió</MudMenuItem>
                                    </ChildContent>
                                </MudMenu>
                            </MudTd>
                            <MudTd>
                                <MudTooltip Text="Atender">
                                    <MudIconButton Icon="@Icons.Material.Filled.AddBox"
                                                   Color="Color.Primary"
                                                   Size="Size.Small"
                                                   OnClick="@(() => AbrirModalAtencion(context))" />
                                </MudTooltip>
                            </MudTd>
                        </RowTemplate>
                        <PagerContent>
                            <MudTablePager PageSizeOptions="new int[] { 10, 25, 50 }"
                                           RowsPerPageString="Filas por página"
                                           InfoFormat="Mostrando {first_item}-{last_item} de {all_items}" />
                        </PagerContent>
                    </MudTable>
                </MudItem>
            </MudGrid>
        </MudPaper>
    </MudContainer>
}
